<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- The official v2 feed is reachable on networks where api.nuget.org times out. -->
    <add key="nuget.org-v2" value="https://www.nuget.org/api/v2/" protocolVersion="2" />
  </packageSources>
</configuration>
