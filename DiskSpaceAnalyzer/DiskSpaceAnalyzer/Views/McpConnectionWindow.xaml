<Window x:Class="DiskSpaceAnalyzer.Views.McpConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Помощь ИИ — подключение" Icon="/DiskSpaceAnalyzer;component/App.ico"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PanelBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI">
    <StackPanel Margin="24">
        <TextBlock Text="Разберите результаты вместе с ИИ" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Margin="0,10,0,18" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                   Text="Скопируйте готовый промпт и вставьте его в чат с ИИ. Агент сможет изучить сохранённый анализ и показать найденные объекты в этом окне приложения." />
        <Button Content="Скопировать промпт для ИИ" Command="{Binding CopyPromptCommand}"
                Height="44" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Stretch" />
        <TextBlock Margin="0,10,0,0" Text="{Binding Feedback}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />
        <Separator Margin="0,16,0,16" />
        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
        <TextBox Text="{Binding Endpoint, Mode=OneWay}" IsReadOnly="True" Margin="0,10,0,12"
                 AutomationProperties.Name="Адрес MCP-сервера" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="{Binding ToggleLabel}" Command="{Binding ToggleServerCommand}" Margin="12,0,0,0" />
            <Button DockPanel.Dock="Right" Content="Применить порт" Command="{Binding ApplyPortCommand}" Margin="8,0,0,0" />
            <TextBlock DockPanel.Dock="Left" Text="Порт" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEdit}"
                     MaxLength="5" MinWidth="72" AutomationProperties.Name="Порт MCP-сервера" />
        </DockPanel>
        <TextBlock Margin="0,18,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                   Text="Подключение работает на этом компьютере, пока приложение открыто. Нужен ИИ-клиент с поддержкой локального MCP по HTTP. Промпт содержит адрес и ключ подключения." />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                   Text="Агент получает пути и метаданные сохранённого анализа. Содержимое файлов недоступно. Удаление и изменение файлов через MCP не предусмотрены." />
        <Button Content="Закрыть" IsCancel="True" HorizontalAlignment="Right" MinWidth="100" Margin="0,20,0,0" />
    </StackPanel>
</Window>
